<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:workspace="clr-namespace:MedScopePro.Controls.Workspace;assembly=MedScopePro.Controls">

    <!-- WorkspaceStyle -->
    <Style x:Key="WorkspaceStyle" TargetType="{x:Type workspace:WorkspaceControl}">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="TabStripPlacement" Value="Top"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type workspace:WorkspaceControl}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Tabs -->
                        <Border Grid.Row="0"
                                Background="White"
                                CornerRadius="20"
                                Height="36"
                                HorizontalAlignment="Center">
                            
                            <TabPanel IsItemsHost="True"/>
                        </Border>
                        
                        <!-- TabContent -->
                        <ContentPresenter Grid.Row="1"
                                          ContentSource="SelectedContent"/>

                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>