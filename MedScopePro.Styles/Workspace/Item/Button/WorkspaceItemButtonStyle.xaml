<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:workspaceItemButton="clr-namespace:MedScopePro.Controls.Workspace._Elements.Item._Elements.Button;assembly=MedScopePro.Controls"
                    xmlns:icon="clr-namespace:MedScopePro.Controls.Icon;assembly=MedScopePro.Controls"
                    xmlns:workspaceItem="clr-namespace:MedScopePro.Controls.Workspace._Elements.Item;assembly=MedScopePro.Controls">

    <!-- WorkspaceItemButtonStyle -->
    <Style x:Key="WorkspaceItemButtonStyle" TargetType="{x:Type workspaceItemButton:WorkspaceItemButtonControl}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="Black"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type workspaceItemButton:WorkspaceItemButtonControl}">
                    <Border x:Name="Border"
		                    Background="{TemplateBinding Background}"
		                    BorderBrush="{TemplateBinding BorderBrush}"
		                    BorderThickness="{TemplateBinding BorderThickness}">

                        <!-- Icon -->
                        <icon:IconControl Grid.Column="0"
                                          x:Name="Icon"
			                              Height="14" Width="14"
			                              IconMaterial="{TemplateBinding Icon}"
			                              Foreground="{TemplateBinding Foreground}"/>

                    </Border>
                    <ControlTemplate.Triggers>

                        <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=workspaceItem:WorkspaceItemControl}}" Value="True">
                            <Setter Property="Foreground" Value="White"/>
                        </DataTrigger>
                        
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Icon" Property="IconStyle" Value="Fill" />
                            <Setter Property="Foreground" Value="#FF3A36" />
                        </Trigger>

                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>