<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:contextMenu="clr-namespace:MedScopePro.Controls._Elements.ContextMenu;assembly=MedScopePro.Controls">

    <!-- ContextMenuStyle -->
    <Style x:Key="ContextMenuStyle" TargetType="{x:Type contextMenu:ContextMenuControl}">
        <Setter Property="Background" Value="White" />
        <Setter Property="Foreground" Value="Black"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type contextMenu:ContextMenuControl}">
                
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>