<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:checkBox="clr-namespace:MedScopePro.Controls._Elements.CheckBox;assembly=MedScopePro.Controls">

    <!-- CheckBoxStyle -->
    <Style x:Key="CheckBoxStyle" TargetType="{x:Type checkBox:CheckBoxControl}">
        <Setter Property="Background" Value="White" />
        <Setter Property="Foreground" Value="Black"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type checkBox:CheckBoxControl}">
                
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>