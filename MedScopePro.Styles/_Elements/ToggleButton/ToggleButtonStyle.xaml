<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:toggleButton="clr-namespace:MedScopePro.Controls._Elements.ToggleButton;assembly=MedScopePro.Controls">

    <!-- ToggleButtonStyle -->
    <Style x:Key="ToggleButtonStyle" TargetType="{x:Type toggleButton:ToggleButtonControl}">
        <Setter Property="Background" Value="White" />
        <Setter Property="Foreground" Value="Black"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type toggleButton:ToggleButtonControl}">
                
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>