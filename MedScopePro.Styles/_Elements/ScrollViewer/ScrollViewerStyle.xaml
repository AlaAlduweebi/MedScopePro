<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:scrollViewer="clr-namespace:MedScopePro.Controls._Elements.ScrollViewer;assembly=MedScopePro.Controls">

    <!-- ScrollViewerStyle -->
    <Style x:Key="ScrollViewerStyle" TargetType="{x:Type scrollViewer:ScrollViewerControl}">
        <Setter Property="Background" Value="White" />
        <Setter Property="Foreground" Value="Black"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type scrollViewer:ScrollViewerControl}">
                
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>