<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:comboBox="clr-namespace:MedScopePro.Controls._Elements.ComboBox;assembly=MedScopePro.Controls">

    <!-- ComboBoxStyle -->
    <Style x:Key="ComboBoxStyle" TargetType="{x:Type comboBox:ComboBoxControl}">
        <Setter Property="Background" Value="White" />
        <Setter Property="Foreground" Value="Black"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type comboBox:ComboBoxControl}">
                
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>