<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:listBox="clr-namespace:MedScopePro.Controls._Elements.ListBox;assembly=MedScopePro.Controls">

    <!-- ListBoxStyle -->
    <Style x:Key="ListBoxStyle" TargetType="{x:Type listBox:ListBoxControl}">
        <Setter Property="Background" Value="White" />
        <Setter Property="Foreground" Value="Black"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type listBox:ListBoxControl}">
                
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>