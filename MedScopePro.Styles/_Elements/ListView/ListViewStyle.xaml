<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:listView="clr-namespace:MedScopePro.Controls._Elements.ListView;assembly=MedScopePro.Controls">

    <!-- ListViewStyle -->
    <Style x:Key="ListViewStyle" TargetType="{x:Type listView:ListViewControl}">
        <Setter Property="Background" Value="White" />
        <Setter Property="Foreground" Value="Black"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type listView:ListViewControl}">
                
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>