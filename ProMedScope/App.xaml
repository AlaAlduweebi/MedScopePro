<Application x:Class="ProMedScope.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:ProMedScope"
             StartupUri="MainView.xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/ProMedScope.Styles;component/_Core/Register/LookAndFeel.xaml" />
                <ResourceDictionary Source="/ProMedScope.Styles;component/_Core/Register/TargetTypes.xaml" />
                <ResourceDictionary Source="/ProMedScope.Templates;component/_Core/Register/LookAndFeel.xaml" />
                <ResourceDictionary Source="/ProMedScope.Templates;component/_Core/Register/TargetTypes.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>