<UserControl x:Class="MedScopePro.Views.Patient.PatientView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:MedScopePro.Views.Patient"
             xmlns:workspace="clr-namespace:MedScopePro.Controls.Workspace;assembly=MedScopePro.Controls" 
             xmlns:patient="clr-namespace:MedScopePro.ViewModels.Patient;assembly=MedScopePro.ViewModels"
             d:DataContext="{d:DesignInstance Type=patient:PatientViewModel}"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid>

        <!-- Workspace -->
        <workspace:WorkspaceControl ItemsSource="{Binding OpenPatients}">
            <workspace:WorkspaceControl.ContentTemplate>
                <DataTemplate>
                    <local:PatientWorkspaceLayout />
                </DataTemplate>
            </workspace:WorkspaceControl.ContentTemplate>
        </workspace:WorkspaceControl>
    </Grid>
</UserControl>