<UserControl x:Class="MedScopePro.Views.Patient.PatientWorkspaceLayout"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:widget="clr-namespace:MedScopePro.Controls.Widget;assembly=MedScopePro.Controls">

    <!-- PatientWorkspaceLayout -->
    <Grid>
        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
            <Grid Margin="20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="2*" MinHeight="400"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*" MinHeight="200"/>
                </Grid.RowDefinitions>

                <!-- Obere Zeile -->
                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*" MinWidth="900"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*" MinWidth="300"/>
                    </Grid.ColumnDefinitions>

                    <!-- Live-Aufnahme Widget -->
                    <widget:WidgetControl Grid.Column="0"
                                          x:Name="LiveRecordingWidget"
                                          Title="Live"
                                          Info="00:04:17"
                                          HorizontalAlignment="Stretch"
                                          VerticalAlignment="Stretch"/>

                    <!-- Vertical GridSplitter -->
                    <GridSplitter Grid.Column="1"
                                  Width="20"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Stretch"
                                  Background="Transparent"
                                  ShowsPreview="False"
                                  ResizeBehavior="PreviousAndNext"
                                  ResizeDirection="Columns"/>

                    <!-- Rechte Spalte -->
                    <Grid Grid.Column="2">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" MinHeight="200"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*" MinHeight="200"/>
                        </Grid.RowDefinitions>

                        <!-- Patient Widget -->
                        <widget:WidgetControl Grid.Row="0"
                                              x:Name="PatientWidget"
                                              Icon="Person"
                                              Title="Patient"
                                              HorizontalAlignment="Stretch"/>

                        <!-- Horizontal GridSplitter -->
                        <GridSplitter Grid.Row="1"
                                      Height="20"
                                      HorizontalAlignment="Stretch"
                                      VerticalAlignment="Center"
                                      Background="Transparent"
                                      ShowsPreview="False"
                                      ResizeDirection="Rows"
                                      ResizeBehavior="PreviousAndNext"
                                      KeyboardNavigation.TabIndex="0"/>

                        <!-- Befunde Widget -->
                        <widget:WidgetControl Grid.Row="2"
                                              x:Name="FindingsWidget"
                                              Icon="Assignment"
                                              Title="Befunde"
                                              HorizontalAlignment="Stretch"/>
                    </Grid>
                </Grid>

                <!-- Horizontal GridSplitter -->
                <GridSplitter Grid.Row="1"
                              Height="20"
                              HorizontalAlignment="Stretch"
                              VerticalAlignment="Center"
                              Background="Transparent"
                              ShowsPreview="False"
                              ResizeDirection="Rows"
                              ResizeBehavior="PreviousAndNext"
                              KeyboardNavigation.TabIndex="0"/>

                <!-- Untere Zeile -->
                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" MinWidth="400"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*" MinWidth="400"/>
                    </Grid.ColumnDefinitions>

                    <!-- Live-Werte Widget -->
                    <widget:WidgetControl Grid.Column="0"
                                          x:Name="LiveValuesWidget"
                                          Icon="Subtitles"
                                          Title="Live-Werte"
                                          HorizontalAlignment="Stretch"/>

                    <!-- Vertical GridSplitter -->
                    <GridSplitter Grid.Column="1"
                                  Width="20"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Stretch"
                                  Background="Transparent"
                                  ResizeDirection="Columns"
                                  ResizeBehavior="PreviousAndNext"/>

                    <!-- Screenshots Widget -->
                    <widget:WidgetControl Grid.Column="2"
                                          x:Name="ScreenshotsWidget"
                                          Icon="PhotoCamera"
                                          Title="Screenshots"
                                          Info="4"
                                          HorizontalAlignment="Stretch"/>
                </Grid>
            </Grid>
        </ScrollViewer>

        <!-- Overlay -->
        <Border x:Name="Overlay"
                Background="#60000000"
                Visibility="Collapsed"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"
                Panel.ZIndex="999"
                Margin="10"
                MouseDown="OverlayMouseDown">

            <Grid HorizontalAlignment="Center"
			      VerticalAlignment="Center">

                <!-- Schatten -->
                <Border x:Name="ShadowBorder"
				        Background="#F4F4F4"
				        CornerRadius="20">

                    <Border.Effect>
                        <DropShadowEffect Color="Black"
						                  Direction="0"
						                  ShadowDepth="0"
						                  BlurRadius="28"
						                  Opacity="0.1" />
                    </Border.Effect>
                </Border>

                <!-- Inhalt -->
                <Border x:Name="OverlayContent"
                        Background="White"
                        CornerRadius="20"
                        Width="900"
                        Height="600"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center">
                </Border>
            </Grid>
        </Border>

    </Grid>
</UserControl>