<UserControl x:Class="MedScopePro.Views.Patient.PatientWorkspaceLayout"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:widget="clr-namespace:MedScopePro.Controls.Widget;assembly=MedScopePro.Controls">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>

            <widget:WidgetControl Grid.Column="0" 
                                  Title="Live-Aufnahme" 
                                  Margin="0,0,0,10"/>

            <Grid Grid.Column="1"
                  Margin="20,0,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <widget:WidgetControl Grid.Row="0"
                                      Title="Patient"/>

                <widget:WidgetControl Grid.Row="1"
                                      Title="Befunde"
                                      Margin="0,20,0,0"/>
            </Grid>
        </Grid>

        <Grid Grid.Row="1"
              Margin="0,20,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>

            <widget:WidgetControl Grid.Column="0"
                                  Title="Live-Werte"/>

            <widget:WidgetControl Grid.Column="1" 
                                  Title="Screenshots" 
                                  Margin="20,0,0,0"/>
        </Grid>
    </Grid>
</UserControl>