<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:icon="clr-namespace:ProMedScope.Controls.Icon;assembly=ProMedScope.Controls"
                    xmlns:titleBarToggleButton="clr-namespace:ProMedScope.Controls.TitleBar._Elements.ToggleButton;assembly=ProMedScope.Controls">

    <!-- TitleBarToggleButtonStyle -->
    <Style x:Key="TitleBarToggleButtonStyle" TargetType="{x:Type titleBarToggleButton:PmTitleBarToggleButton}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="Black"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type titleBarToggleButton:PmTitleBarToggleButton}">
                    <Border x:Name="Border"
					        Background="{TemplateBinding Background}"
					        BorderBrush="{TemplateBinding BorderBrush}"
					        BorderThickness="{TemplateBinding BorderThickness}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <!-- Icon -->
                            <icon:PmIcon Grid.Column="0"
                                         x:Name="Icon"
						                 Height="16" Width="16"
						                 IconMaterial="{TemplateBinding Icon}"
						                 Foreground="{TemplateBinding Foreground}"
                                         Visibility="Collapsed"/>

                            <StackPanel Grid.Column="1"
                                        Orientation="Horizontal">
                                
                                <!-- Label -->
                                <TextBlock x:Name="Label"
                                           Text="{TemplateBinding Content}"
                                           Foreground="{TemplateBinding Foreground}"
                                           Margin="0,0,10,0"
							               VerticalAlignment="Center"
                                           Visibility="Collapsed"/>

                                <!-- Image -->
                                <Image x:Name="Image"
                                       Height="40"
                                       VerticalAlignment="Center"
                                       Visibility="Collapsed"/>
                                
                            </StackPanel>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>

                        <Trigger Property="ButtonName" Value="Design">
                            <Setter TargetName="Icon" Property="Visibility" Value="Visible" />
                        </Trigger>

                        <Trigger Property="ButtonName" Value="Language">
                            <Setter TargetName="Image" Property="Source" Value="/ProMedScope.Styles;component/_Core/Resources/Images/Englich.jpg" />
                            <Setter TargetName="Image" Property="Visibility" Value="Visible" />
                            <Setter TargetName="Image" Property="Height" Value="30"/>
                        </Trigger>

                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="ButtonName" Value="Language" />
                                <Condition Property="IsChecked" Value="True" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="Image" Property="Source" Value="/ProMedScope.Styles;component/_Core/Resources/Images/German.jpg" />
                        </MultiTrigger>
                        
                        <Trigger Property="ButtonName" Value="Profile">
                            <Setter TargetName="Label" Property="Visibility" Value="Visible" />
                            <Setter TargetName="Image" Property="Source" Value="/ProMedScope.Styles;component/_Core/Resources/Images/ProfilePhoto.png" />
                            <Setter TargetName="Image" Property="Visibility" Value="Visible" />
                            <Setter TargetName="Image" Property="Height" Value="40"/>
                        </Trigger>

                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="#F6F6F6" />
                        </Trigger>
                        
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>