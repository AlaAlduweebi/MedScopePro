<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:tabItem="clr-namespace:ProMedScope.Controls._Elements.TabControl.TabItem;assembly=ProMedScope.Controls">

    <!-- TabItemStyle -->
    <Style x:Key="TabItemStyle" TargetType="{x:Type tabItem:TabItemControl}">
        <Setter Property="Background" Value="White" />
        <Setter Property="Foreground" Value="Black"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type tabItem:TabItemControl}">
                
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>