<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:tabControlTabItem="clr-namespace:ProMedScope.Controls._Elements.TabControl.TabItem;assembly=ProMedScope.Controls">

    <!-- TabControlTabItemStyle -->
    <Style x:Key="TabControlTabItemStyle" TargetType="{x:Type tabControlTabItem:PmTabControlTabItem}">
        <Setter Property="Background" Value="White" />
        <Setter Property="Foreground" Value="Black"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type tabControlTabItem:PmTabControlTabItem}">
                
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>