<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:contentControl="clr-namespace:ProMedScope.Controls._Elements.ContentControl;assembly=ProMedScope.Controls">

    <!-- ContentControlStyle -->
    <Style x:Key="ContentControlStyle" TargetType="{x:Type contentControl:ContentControl}">
        <Setter Property="Background" Value="White" />
        <Setter Property="Foreground" Value="Black"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type contentControl:ContentControl}">
                
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>