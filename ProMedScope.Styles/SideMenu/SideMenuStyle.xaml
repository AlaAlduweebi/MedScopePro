<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sideMenu="clr-namespace:ProMedScope.Controls.SideMenu;assembly=ProMedScope.Controls">

    <!-- SideMenuStyle -->
    <Style x:Key="SideMenuStyle" TargetType="{x:Type sideMenu:PmSideMenu}">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="TabStripPlacement" Value="Left"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type sideMenu:PmSideMenu}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- SideMenu -->
                        <Border Grid.Column="0"
                                Background="White"
                                Margin="20,0,0,0"
                                CornerRadius="40"
                                Width="70" Height="460">
                            <TabPanel VerticalAlignment="Center" IsItemsHost="True"/>
                        </Border>

                        <!-- TabContent -->
                        <ContentPresenter Grid.Column="1"
                                          Content="{Binding SelectedItem.View, RelativeSource={RelativeSource TemplatedParent}}"/>
                        
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>