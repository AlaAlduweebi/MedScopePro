<UserControl x:Class="ProMedScope.Views.Patient.PatientView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:ProMedScope.Views.Patient"
             xmlns:workspace="clr-namespace:ProMedScope.Controls.Workspace;assembly=ProMedScope.Controls" 
             xmlns:patient="clr-namespace:ProMedScope.ViewModels.Patient;assembly=ProMedScope.ViewModels"
             d:DataContext="{d:DesignInstance Type=patient:PatientViewModel}"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid>
        <workspace:WorkspaceControl ItemsSource="{Binding OpenPatients}"/>
    </Grid>
</UserControl>