<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:widget="clr-namespace:MedScopePro.Controls.Widget;assembly=MedScopePro.Controls"
                    xmlns:icon="clr-namespace:MedScopePro.Controls.Icon;assembly=MedScopePro.Controls"
                    xmlns:widgetButton="clr-namespace:MedScopePro.Controls.Widget._Elements.Button;assembly=MedScopePro.Controls">

    <!-- WidgetTemplate -->
    <ControlTemplate x:Key="WidgetTemplate" TargetType="{x:Type widget:WidgetControl}">
        <Border x:Name="Border" 
                Background="White"
                BorderThickness="1"
                CornerRadius="20"
                Padding="10">

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition/>
                    <RowDefinition/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0"
                      x:Name="HeadGrid"
                      VerticalAlignment="Top">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0"
                                Orientation="Horizontal">

                        <!-- Icon Hintergrund -->
                        <Border x:Name="IconBackground"
                                Background="#F6F6F6"
                                CornerRadius="40"
                                Width="44" Height="44">

                            <!-- Icon -->
                            <icon:IconControl x:Name="Icon"
					                          Height="22" Width="22"
					                          IconMaterial="{TemplateBinding Icon}"
                                              IconStyle="Fill"
					                          Foreground="{TemplateBinding Foreground}"/>
                        </Border>

                        <!-- Titel + Info -->
                        <StackPanel Margin="10,0,0,0" 
                                    Orientation="Horizontal"
                                    VerticalAlignment="Center">

                            <!-- Titel -->
                            <TextBlock x:Name="Title"
                                       FontStyle="Italic" 
                                       Text="{TemplateBinding Title}"/>

                            <!-- Separator -->
                            <TextBlock x:Name="Separator"
                                       Margin="10,0,10,0" 
                                       FontStyle="Italic"
                                       Text="•"/>

                            <!-- Info -->
                            <TextBlock x:Name="Info"
                                       FontStyle="Italic"
                                       Text="{TemplateBinding Info}"/>

                        </StackPanel>
                    </StackPanel>
                   

                    <!-- MaximizeButton -->
                    <widgetButton:WidgetButtonControl
                        Grid.Column="1"
                        x:Name="MaximizeButton"
                        ButtonName="Maximize"
                        Margin="0,0,10,0"
                        HorizontalAlignment="Right"/>
                    
                </Grid>

                <!-- Inhalt -->
                <ContentPresenter Grid.Row="1"/>
                
            </Grid>
        </Border>
        <ControlTemplate.Triggers>
            
            <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Border" Property="BorderBrush" Value="#2978F5"/>
                <Setter TargetName="IconBackground" Property="Background" Value="#2978F5"/>
                <Setter TargetName="Icon" Property="IconStyle" Value="Outline"/>
                <Setter TargetName="Icon" Property="Foreground" Value="White"/>
                <Setter TargetName="Title" Property="Foreground" Value="#2978F5"/>
                <Setter TargetName="Separator" Property="Foreground" Value="#2978F5"/>
                <Setter TargetName="Info" Property="Foreground" Value="#2978F5"/>
            </Trigger>

            <Trigger Property="Info" Value="{x:Null}">
                <Setter TargetName="Separator" Property="Visibility" Value="Collapsed"/>
            </Trigger>

            <Trigger Property="Title" Value="Live">
                <Setter TargetName="HeadGrid" Property="Margin" Value="14,10,0,0"/>
                <Setter TargetName="IconBackground" Property="Width" Value="10"/>
                <Setter TargetName="IconBackground" Property="Height" Value="10"/>
                <Setter TargetName="IconBackground" Property="Background" Value="#FF3A36"/>
                <Setter TargetName="Title" Property="Foreground" Value="#FF3A36"/>
            </Trigger>

        </ControlTemplate.Triggers>
    </ControlTemplate>
</ResourceDictionary>