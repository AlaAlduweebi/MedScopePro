<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:titleBar="clr-namespace:MedScopePro.Controls.TitleBar;assembly=MedScopePro.Controls"
                    xmlns:widget="clr-namespace:MedScopePro.Controls.Widget;assembly=MedScopePro.Controls">

    <!-- WidgetTemplate -->
    <ControlTemplate x:Key="WidgetTemplate" TargetType="{x:Type widget:WidgetControl}">
        <Border Background="White"
                BorderThickness="0"
                CornerRadius="20"
                Padding="6">

            <StackPanel>

                <!-- Titel -->
                <TextBlock Text="{TemplateBinding Title}"/>

                <!-- Inhalt -->
                <ContentPresenter/>
                
            </StackPanel>
        </Border>
    </ControlTemplate>
</ResourceDictionary>