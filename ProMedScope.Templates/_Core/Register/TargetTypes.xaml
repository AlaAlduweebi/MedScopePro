<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:titleBar="clr-namespace:ProMedScope.Controls.TitleBar;assembly=ProMedScope.Controls"
                    xmlns:mainView="clr-namespace:ProMedScope.Controls.MainView;assembly=ProMedScope.Controls">

    <!-- TitleBar -->
    <Style TargetType="{x:Type titleBar:TitleBarControl}">
        <Setter Property="Template" Value="{DynamicResource TitleBarTemplate}" />
    </Style>
    
    <!-- MainView -->
    <Style TargetType="{x:Type mainView:MainViewControl}">
        <Setter Property="Template" Value="{DynamicResource MainViewTemplate}" />
    </Style>
    
</ResourceDictionary>