<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:mainView="clr-namespace:ProMedScope.Controls.MainView;assembly=ProMedScope.Controls"
                    xmlns:titleBar="clr-namespace:ProMedScope.Controls.TitleBar;assembly=ProMedScope.Controls"
                    xmlns:sideMenu="clr-namespace:ProMedScope.Controls.SideMenu;assembly=ProMedScope.Controls">

    <!-- MainViewTemplate -->
    <ControlTemplate x:Key="MainViewTemplate" TargetType="{x:Type mainView:PmMainView}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="60"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- TitleBar -->
            <titleBar:PmTitleBar Grid.Row="0" 
                                 x:Name="TitleBar"/>

            <!-- ContentBorder -->
            <Border Grid.Row="1" 
                    x:Name="ContentBorder"
                    Background="#F6F6F6" 
                    CornerRadius="14"
                    Margin="20,0,20,20">

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- SideMenu -->
                    <sideMenu:PmSideMenu 
                        Grid.Column="0"
                        x:Name="SideMenu"
                        SelectedIndex="1"
                        VerticalAlignment="Center"/>

                    <!-- Content -->
                    <ContentPresenter Grid.Column="1"
                                      Content="{Binding CurrentView}"/>
                </Grid>
            </Border>
        </Grid>
    </ControlTemplate>
</ResourceDictionary>