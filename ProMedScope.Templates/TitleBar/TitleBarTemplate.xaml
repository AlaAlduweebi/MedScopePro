<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:titleBar="clr-namespace:ProMedScope.Controls.TitleBar;assembly=ProMedScope.Controls"
                    xmlns:titleBarToggleButton="clr-namespace:ProMedScope.Controls.TitleBar._Elements.ToggleButton;assembly=ProMedScope.Controls">

    <!-- TitleBarTemplate -->
    <ControlTemplate x:Key="TitleBarTemplate" TargetType="{x:Type titleBar:PmTitleBar}">
        <Border Background="White"
                Padding="30,0,30,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>

                <!-- TitleBarLogo -->
                <Image Grid.Column="0"
                       x:Name="TitleBarLogo"
                       Source="/ProMedScope.Styles;component/_Core/Resources/Images/TitleBarLogo.png"
                       Height="120"
                       HorizontalAlignment="Left"
                       VerticalAlignment="Center"/>

                <Grid Grid.Column="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>

                    <!-- Separator -->
                    <Border Grid.Column="1"
                            Width="1"
                            Height="20"
                            Background="Black"/>

                    <!-- ProfileToggleButton -->
                    <titleBarToggleButton:PmTitleBarToggleButton
                        Grid.Column="1"
                        x:Name="ProfileToggleButton"
                        ButtonName="Profile"
                        HorizontalAlignment="Right"/>

                </Grid>
            </Grid>
        </Border>
    </ControlTemplate>
</ResourceDictionary>