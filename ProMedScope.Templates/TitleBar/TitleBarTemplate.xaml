<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:titleBar="clr-namespace:ProMedScope.Controls.TitleBar;assembly=ProMedScope.Controls"
                    xmlns:titleBarToggleButton="clr-namespace:ProMedScope.Controls.TitleBar._Elements.ToggleButton;assembly=ProMedScope.Controls">

    <!-- TitleBarTemplate -->
    <ControlTemplate x:Key="TitleBarTemplate" TargetType="{x:Type titleBar:TitleBarControl}">
        <Border Background="White"
                Padding="30,0,30,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- TitleBarLogo -->
                <Image Grid.Column="0"
                       x:Name="TitleBarLogo"
                       Source="/ProMedScope.Styles;component/_Core/Resources/Images/TitleBarLogo.png"
                       Height="120"
                       HorizontalAlignment="Left"
                       VerticalAlignment="Center"/>

                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center">

                    <!-- DesignToggleButton -->
                    <titleBarToggleButton:TitleBarToggleButtonControl
                        x:Name="DesignToggleButton"
                        ButtonName="Design"
                        Margin="0,0,20,0"/>

                    <!-- LanguageToggleButton -->
                    <titleBarToggleButton:TitleBarToggleButtonControl
                        x:Name="LanguageToggleButton"
                        ButtonName="Language"
                        Margin="0,0,20,0"/>

                    <!-- Separator -->
                    <Border Width="1"
                            Height="20"
                            Background="Black"
                            Margin="0,0,20,0"
                            VerticalAlignment="Center"/>

                    <!-- ProfileToggleButton -->
                    <titleBarToggleButton:TitleBarToggleButtonControl
                        x:Name="ProfileToggleButton"
                        ButtonName="Profile"/>
                    
                </StackPanel>
            </Grid>
        </Border>
    </ControlTemplate>
</ResourceDictionary>